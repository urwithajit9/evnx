# ── Application ──
# (required)
API_PREFIX=your_api_prefix_value
# Allowed CORS origins (comma-separated) (required)
CORS_ORIGIN=http://localhost:3000
# (required)
NODE_ENV=development


# ── Security ──
# Secret for signing JWT tokens (required)
JWT_SECRET=your_jwt_secret_value


# ── Database ──
MONGODB_DB_NAME=your_mongodb_db_name_value
MONGODB_URI=mongodb://localhost:27017


# ── Cache ──
REDIS_DB=0
REDIS_HOST=localhost
REDIS_PASSWORD=your_redis_password_value
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0


# ── Authentication ──
AUTH0_AUDIENCE=your_auth0_audience_value
AUTH0_CLIENT_ID=your_auth0_client_id_value
AUTH0_CLIENT_SECRET=your_auth0_client_secret_value
AUTH0_DOMAIN=your_auth0_domain_value


# ── Connection ──
# (required)
PORT=3000


# ── Containerization ──
DOCKER_IMAGE_NAME=your_docker_image_name_value
DOCKER_REGISTRY_URL=docker.io

# Generated by evnx <version> on <date>
