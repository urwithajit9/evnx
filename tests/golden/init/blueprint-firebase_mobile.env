# Generated by evnx. Replace the placeholder values below with real ones.

# ── Application ──
# (required - must be set)
API_PREFIX=your_api_prefix_value
# Allowed CORS origins (comma-separated)
# (required - must be set)
CORS_ORIGIN=http://localhost:3000
# (required - must be set)
NODE_ENV=development

# ── Security ──
# Secret for signing JWT tokens
# (required - must be set)
JWT_SECRET=your_jwt_secret_value

# ── CI/CD ──
ACTIONS_RUNTIME_TOKEN=your_actions_runtime_token_value
GITHUB_TOKEN=your_github_token_value

# ── Authentication ──
GOOGLE_CALLBACK_URL=https://example.com
GOOGLE_CLIENT_ID=your_google_client_id_value
GOOGLE_CLIENT_SECRET=your_google_client_secret_value

# ── Backend-as-a-Service ──
FIREBASE_API_KEY=your_firebase_api_key_value
FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_value
FIREBASE_PROJECT_ID=your_firebase_project_id_value
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_value

# ── Connection ──
# (required - must be set)
PORT=3000

# ── Logging ──
LOGTAIL_SOURCE_TOKEN=your_logtail_source_token_value
