# ── Application ──
# (required)
APP_DEBUG=true
# (required)
LOG_CHANNEL=stack


# ── Security ──
# Laravel encryption key (generate with: php artisan key:generate) (required)
APP_KEY=your_app_key_value


# ── Database ──
DATABASE_URL=mysql://user:password@localhost:3306/dbname
# (required)
DB_CONNECTION=mysql
DB_DATABASE=your_db_database_value
DB_HOST=localhost
DB_PASSWORD=your_db_password_value
DB_PORT=3306
DB_USER=your_db_user_value


# ── Cache ──
REDIS_DB=0
REDIS_HOST=localhost
REDIS_PASSWORD=your_redis_password_value
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0


# ── CI/CD ──
ACTIONS_RUNTIME_TOKEN=your_actions_runtime_token_value
GITHUB_TOKEN=your_github_token_value


# ── Connection ──
# (required)
APP_URL=http://localhost


# ── Payments ──
# Publishable key (safe for client-side)
STRIPE_PUBLIC_KEY=your_stripe_public_key_value
# Secret key (server-side only)
STRIPE_SECRET_KEY=your_stripe_secret_key_value
# Secret for verifying webhook signatures
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_value

# Generated by evnx <version> on <date>
