# Generated by evnx. Replace the placeholder values below with real ones.

# ── Application ──
# (required - must be set)
VITE_APP_TITLE=your_vite_app_title_value
# (required - must be set)
VITE_ENV=development

# ── Authentication ──
# Public key for client-side Clerk SDK
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_value
# Secret key for server-side Clerk API
CLERK_SECRET_KEY=your_clerk_secret_key_value
# Client-side copy of CLERK_PUBLISHABLE_KEY (exposed to the browser by Vite)
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_value

# ── Backend-as-a-Service ──
# Public anon key for client-side usage
SUPABASE_ANON_KEY=your_supabase_anon_key_value
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_value
# Secret service key (server-side only!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_value
SUPABASE_URL=https://example.com
# Client-side copy of SUPABASE_ANON_KEY (exposed to the browser by Vite)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_value
# Client-side copy of SUPABASE_URL (exposed to the browser by Vite)
VITE_SUPABASE_URL=https://example.com

# ── Connection ──
# Base URL for API requests
# (required - must be set)
VITE_API_BASE_URL=https://example.com

# ── Deployment Platform ──
VERCEL_ORG_ID=your_vercel_org_id_value
VERCEL_PROJECT_ID=your_vercel_project_id_value
# API token for Vercel CLI deployments
VERCEL_TOKEN=your_vercel_token_value
