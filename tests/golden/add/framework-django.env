APP_NAME=my-app

# ── Framework: Django ──

# ── Application ──
# (required)
DEBUG=True
# (required)
DJANGO_SETTINGS_MODULE=myproject.settings


# ── Security ──
# Comma-separated list of allowed host/domain names (required)
ALLOWED_HOSTS=localhost,127.0.0.1
# Django secret key (generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())') (required)
SECRET_KEY=your_secret_key_value


# ── Database ──
# (required)
DATABASE_URL=https://example.com

