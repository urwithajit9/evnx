APP_NAME=my-app

# ── Blueprint: Rust Speedstack (Axum + SQLx + Postgres) ──

# ── Application ──
# (required)
APP_ENV=development
# Log level filter (e.g., info, debug, trace) (required)
RUST_LOG=info
# Address to bind the HTTP server (required)
SOCKET_ADDR=0.0.0.0:8080


# ── Database ──
# (required)
DATABASE_URL=https://example.com
DB_HOST=localhost
# (required)
DB_NAME=your_db_name_value
# Database password (use strong value in production)
DB_PASSWORD=your_db_password_value
DB_PORT=5432
# (required)
DB_USER=your_db_user_value


# ── Cache ──
REDIS_DB=0
REDIS_HOST=localhost
REDIS_PASSWORD=your_redis_password_value
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0


# ── CI/CD ──
ACTIONS_RUNTIME_TOKEN=your_actions_runtime_token_value
GITHUB_TOKEN=your_github_token_value


# ── Containerization ──
COMPOSE_PROJECT_NAME=your_compose_project_name_value
DOCKER_BUILDKIT=1
DOCKER_DEFAULT_PLATFORM=linux/amd64


# ── Error Tracking ──
SENTRY_AUTH_TOKEN=your_sentry_auth_token_value
# Data Source Name for error tracking
SENTRY_DSN=your_sentry_dsn_value
SENTRY_ORG=your_sentry_org_value
SENTRY_PROJECT=your_sentry_project_value

# Added by evnx add on <date>
