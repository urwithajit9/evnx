APP_NAME=my-app

# ── Blueprint: AI/ML Backend (FastAPI + Redis + S3) ──

# ── Application ──
# (required)
APP_ENV=development


# ── Security ──
# (required)
SECRET_KEY=your_secret_key_value


# ── Database ──
# (required)
DATABASE_URL=https://example.com
DB_HOST=localhost
# (required)
DB_NAME=your_db_name_value
# Database password (use strong value in production)
DB_PASSWORD=your_db_password_value
DB_PORT=5432
# (required)
DB_USER=your_db_user_value


# ── Cache ──
REDIS_DB=0
REDIS_HOST=localhost
REDIS_PASSWORD=your_redis_password_value
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0


# ── AI/ML ──
OPENAI_API_KEY=your_openai_api_key_value
OPENAI_ORG_ID=your_openai_org_id_value
OPENAI_PROJECT_ID=your_openai_project_id_value


# ── Cloud Provider ──
AWS_REGION=your_aws_region_value


# ── Cloud Storage ──
# AWS access key (use IAM roles in production)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_value
AWS_ENDPOINT=https://example.com
AWS_S3_BUCKET=your_aws_s3_bucket_value
AWS_S3_REGION=your_aws_s3_region_value
# AWS secret key (never commit to version control)
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_value


# ── Connection ──
# (required)
HOST=0.0.0.0
# (required)
PORT=8000

# Added by evnx add on <date>
