APP_NAME=my-app

# ── Blueprint: Go Cloud Native (Gin + Kafka + Postgres) ──

# ── Application ──
# (required)
APP_ENV=development
# (required)
GIN_MODE=debug


# ── Database ──
# Full connection string (overrides individual DB_* vars)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DB_HOST=localhost
# (required)
DB_NAME=your_db_name_value
# Database password (use strong value in production)
DB_PASSWORD=your_db_password_value
DB_PORT=5432
# (required)
DB_SOURCE=your_db_source_value
# (required)
DB_USER=your_db_user_value


# ── Connection ──
# (required)
PORT=8080


# ── Message Queue ──
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=your_kafka_client_id_value
KAFKA_GROUP_ID=your_kafka_group_id_value


# ── Observability ──
DD_API_KEY=your_dd_api_key_value
DD_APP_KEY=your_dd_app_key_value
DD_ENV=your_dd_env_value
DD_SITE=datadoghq.com


# ── Orchestration ──
K8S_CONTEXT=your_k8s_context_value
K8S_NAMESPACE=default
KUBECONFIG_PATH=~/.kube/config

# Added by evnx add on <date>
