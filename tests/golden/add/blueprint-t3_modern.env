APP_NAME=my-app

# ── Blueprint: T3 Turbo (Next.js + Clerk + Prisma) ──

# ── Application ──
# Canonical URL for your app (required)
NEXTAUTH_URL=http://localhost:3000
# Public app URL for client-side usage (required)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── Database ──
# Full connection string (overrides individual DB_* vars)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DB_HOST=localhost
# (required)
DB_NAME=your_db_name_value
# Database password (use strong value in production)
DB_PASSWORD=your_db_password_value
DB_PORT=5432
# (required)
DB_USER=your_db_user_value


# ── CI/CD ──
ACTIONS_RUNTIME_TOKEN=your_actions_runtime_token_value
GITHUB_TOKEN=your_github_token_value


# ── API ──
# (required)
NEXT_PUBLIC_API_URL=https://example.com


# ── Authentication ──
# Public key for client-side Clerk SDK
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_value
# Secret key for server-side Clerk API
CLERK_SECRET_KEY=your_clerk_secret_key_value
# Secret for NextAuth.js session encryption (generate with openssl) (required)
NEXTAUTH_SECRET=your_nextauth_secret_value
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_next_public_clerk_publishable_key_value


# ── Cloud Storage ──
# AWS access key (use IAM roles in production)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_value
AWS_ENDPOINT=https://example.com
AWS_S3_BUCKET=your_aws_s3_bucket_value
AWS_S3_REGION=your_aws_s3_region_value
# AWS secret key (never commit to version control)
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_value


# ── Deployment Platform ──
NEXT_PUBLIC_VERCEL_ENV=your_next_public_vercel_env_value
VERCEL_ORG_ID=your_vercel_org_id_value
VERCEL_PROJECT_ID=your_vercel_project_id_value
# API token for Vercel CLI deployments
VERCEL_TOKEN=your_vercel_token_value


# ── Payments ──
# Client-side copy of STRIPE_PUBLIC_KEY (exposed to the browser by Next.js)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=your_stripe_public_key_value
# Publishable key (safe for client-side)
STRIPE_PUBLIC_KEY=your_stripe_public_key_value
# Secret key (server-side only)
STRIPE_SECRET_KEY=your_stripe_secret_key_value
# Secret for verifying webhook signatures
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_value

# Added by evnx add on <date>
