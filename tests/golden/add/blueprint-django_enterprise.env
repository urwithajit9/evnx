APP_NAME=my-app

# ── Blueprint: Django Secure (Django + Postgres + Celery) ──

# ── Application ──
# (required)
DEBUG=True
# (required)
DJANGO_SETTINGS_MODULE=myproject.settings


# ── Security ──
# Comma-separated list of allowed host/domain names (required)
ALLOWED_HOSTS=localhost,127.0.0.1
# Django secret key (generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())') (required)
SECRET_KEY=your_secret_key_value


# ── Database ──
# (required)
DATABASE_URL=https://example.com
DB_HOST=localhost
# (required)
DB_NAME=your_db_name_value
# Database password (use strong value in production)
DB_PASSWORD=your_db_password_value
DB_PORT=5432
# (required)
DB_USER=your_db_user_value


# ── Cache ──
REDIS_DB=0
REDIS_HOST=localhost
REDIS_PASSWORD=your_redis_password_value
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0


# ── Cloud Provider ──
AWS_ACCESS_KEY_ID=your_aws_access_key_id_value
AWS_REGION=your_aws_region_value
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_value


# ── Error Tracking ──
SENTRY_AUTH_TOKEN=your_sentry_auth_token_value
# Data Source Name for error tracking
SENTRY_DSN=your_sentry_dsn_value
SENTRY_ORG=your_sentry_org_value
SENTRY_PROJECT=your_sentry_project_value


# ── Message Queue ──
RABBITMQ_DEFAULT_PASS=your_rabbitmq_default_pass_value
RABBITMQ_DEFAULT_USER=your_rabbitmq_default_user_value
RABBITMQ_URL=amqp://localhost:5672

# Added by evnx add on <date>
