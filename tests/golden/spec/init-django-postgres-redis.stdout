# from PostgreSQL
description = "Database password (use strong value in production)"
required = false
secret = true

[vars.DB_PORT]
# from PostgreSQL
required = false
format = "port"

[vars.DB_USER]
# from PostgreSQL
required = true

[vars.DEBUG]
# from Django
required = true
format = "bool"

[vars.DJANGO_SETTINGS_MODULE]
# from Django
required = true

[vars.REDIS_DB]
