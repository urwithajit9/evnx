{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "results": [
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "./.env"
                },
                "region": {
                  "startLine": 2
                }
              }
            }
          ],
          "message": {
            "text": "AWS Access Key detected"
          },
          "ruleId": "secret/aws-access-key"
        }
      ],
      "tool": {
        "driver": {
          "name": "evnx scan",
          "version": "<version>"
        }
      }
    }
  ],
  "version": "2.1.0"
}
